---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedPost from '@/components/FeaturedPost.astro';
import PostRow from '@/components/PostRow.astro';
import Icon from '@/components/Icon.astro';
import { getWriteups } from '@/lib/content';

const posts = await getWriteups();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featuredPost?.id);
const noteCount = String(posts.length).padStart(2, '0');
---

<BaseLayout
  title="Writeups"
  description="Cybersecurity writeups, vulnerability research, technical articles, and CTF notes by Rishi Raj Singh Chauhan."
>
  <section class="page-hero page-hero--archive">
    <div class="container page-hero__inner">
      <div>
        <p class="eyebrow" data-reveal>Writeups <span class="sep">/</span> {noteCount}</p>
        <h1 class="page-hero__title" data-reveal style="--reveal-delay: 70ms">
          A lot on my mind.<br />Here’s <em>some of it.</em>
        </h1>
      </div>

      <div class="page-hero__aside" data-reveal style="--reveal-delay: 110ms">
        <p>
          The bug, the proof, and the fix: bug bounty findings, lab walkthroughs, and CVE
          breakdowns.
        </p>
        <a class="text-link" href="/rss.xml" style="margin-top: 22px">
          Subscribe via RSS
          <Icon name="rss" />
        </a>
      </div>
    </div>
  </section>

  <section class="section writeups-index" aria-labelledby="writeups-heading">
    <div class="container">
      <h2 class="visually-hidden" id="writeups-heading">All writeups</h2>

      <div class="writeups-feed">
        {featuredPost ? (
          <>
            <FeaturedPost post={featuredPost} label="Featured note" />
            {rest.length > 0 && (
              <div class="notes-list">
                {rest.map((post) => (
                  <PostRow post={post} />
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="search-empty is-visible">
            <h2 class="search-empty__title">The first note is being written.</h2>
            <p class="search-empty__text">
              There are no published writeups yet. Check back soon.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
